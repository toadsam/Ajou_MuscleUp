    {
      "id": "file:backend/src/main/java/com/ajou/muscleup/controller/FileController.java",
      "type": "file",
      "name": "FileController.java",
      "filePath": "backend/src/main/java/com/ajou/muscleup/controller/FileController.java",
      "summary": "/api/files 하위의 파일 업로드·삭제·프록시 조회·목록/페이징 API를 제공하는 REST 컨트롤러입니다. app.s3.enabled 설정에 따라 AWS S3와 로컬 파일시스템 두 가지 스토리지 백엔드를 동일한 인터페이스로 전환해 처리합니다.",
      "tags": ["api-handler", "file-upload", "storage", "s3", "controller"],
      "complexity": "complex",
      "languageNotes": "S3/로컬 이중 스토리지를 useS3() 분기로 감싸고, target.startsWith(root) 검사로 경로 탈출(Path Traversal)을 방어합니다."
    },
    {
      "id": "class:backend/src/main/java/com/ajou/muscleup/controller/FileController.java:FileController",
