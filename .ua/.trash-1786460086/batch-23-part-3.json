  "nodes": [
    {
      "id": "file:backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java",
      "type": "file",
      "name": "PostgresSchemaRepairRunner.java",
      "filePath": "backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java",
      "summary": "애플리케이션 기동 시 PostgreSQL의 cms_events 테이블 컬럼이 bytea로 잘못 생성돼 있으면 varchar/text로 되돌리는 스키마 자가 복구 러너입니다. 실패해도 경고 로그만 남기고 부팅을 막지 않습니다.",
      "tags": ["migration", "database", "startup", "postgresql", "schema-repair"],
      "complexity": "moderate",
      "languageNotes": "ApplicationRunner + JdbcTemplate로 information_schema를 조회해 조건부 DDL을 실행하는 방어적 마이그레이션 패턴입니다."
    },
    {
      "id": "class:backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java:PostgresSchemaRepairRunner",
      "type": "class",
      "name": "PostgresSchemaRepairRunner",
      "filePath": "backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java",
      "lineRange": [11, 60],
      "summary": "ApplicationRunner를 구현해 부팅 직후 실행되며, JdbcTemplate으로 컬럼 타입을 점검하고 필요할 때만 ALTER TABLE을 수행합니다.",
      "tags": ["migration", "database", "startup", "runner"],
      "complexity": "moderate"
    },
    {
      "id": "function:backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java:run",
      "type": "function",
      "name": "run",
      "filePath": "backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java",
      "lineRange": [18, 27],
      "summary": "cms_events 테이블의 title·summary·content 세 컬럼에 대해 복구 루틴을 순차 호출하고, 예외가 발생하면 경고 로그만 남기고 조용히 넘어갑니다.",
      "tags": ["startup", "migration", "error-handling", "database"],
      "complexity": "simple"
    },
    {
      "id": "function:backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java:repairIfBytea",
      "type": "function",
      "name": "repairIfBytea",
      "filePath": "backend/src/main/java/com/ajou/muscleup/config/PostgresSchemaRepairRunner.java",
      "lineRange": [29, 59],
      "summary": "information_schema.columns에서 대상 컬럼의 데이터 타입을 조회해 bytea인 경우에만 convert_from(UTF8)을 사용한 ALTER TABLE로 지정 타입으로 변환합니다.",
      "tags": ["migration", "database", "sql", "idempotent"],
      "complexity": "moderate"
    },
    {
      "id": "file:backend/src/main/java/com/ajou/muscleup/config/SchedulingConfig.java",
      "type": "file",
      "name": "SchedulingConfig.java",
      "filePath": "backend/src/main/java/com/ajou/muscleup/config/SchedulingConfig.java",
      "summary": "@EnableScheduling만 선언한 설정 클래스로, scheduler 패키지의 @Scheduled 배치 작업(출석 마감, 랭킹 집계 등)이 주기적으로 실행되도록 스케줄러를 활성화합니다.",
      "tags": ["configuration", "scheduler", "spring-config", "batch"],
