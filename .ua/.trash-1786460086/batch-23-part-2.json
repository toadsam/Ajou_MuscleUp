      "lineRange": [13, 38],
      "summary": "CorsConfigurationSource 빈을 등록하는 설정 클래스로, SecurityConfig의 필터 체인이 이 빈을 주입받아 CORS 정책을 적용합니다.",
      "tags": ["configuration", "cors", "spring-config", "security"],
      "complexity": "simple"
    },
