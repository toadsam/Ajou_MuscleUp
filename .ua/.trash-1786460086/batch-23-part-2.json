    {
      "id": "file:backend/src/main/java/com/ajou/muscleup/config/CorsConfig.java",
      "type": "file",
      "name": "CorsConfig.java",
      "filePath": "backend/src/main/java/com/ajou/muscleup/config/CorsConfig.java",
      "summary": "프론트엔드 오리진에서의 크로스 도메인 호출을 허용하는 CORS 설정을 정의합니다. cors.allowed-origins 프로퍼티로 허용 오리진을 주입받고, 쿠키 인증을 위해 credentials 허용과 Set-Cookie 노출을 함께 설정합니다.",
      "tags": ["configuration", "cors", "security", "spring-config"],
      "complexity": "simple"
    },
